<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- Keep in step with the ADBC checkout's Directory.Packages.props. -->
    <PackageVersion Include="Apache.Arrow" Version="23.0.0" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <!-- Baseline for benchmarks and the correctness oracle for tests only. -->
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <!-- Transitive pin: SqlClient 7.1.1 pulls a vulnerable 9.0.x. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <!-- netstandard2.0 only. -->
    <PackageVersion Include="Microsoft.Win32.Registry" Version="5.0.0" />
    <PackageVersion Include="System.Text.Encoding.CodePages" Version="10.0.3" />
    <PackageVersion Include="System.Threading.Channels" Version="10.0.3" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Xunit.SkippableFact" Version="1.5.85" />
  </ItemGroup>

</Project>
