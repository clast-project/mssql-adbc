<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Multi-targeted: clear the single TargetFramework from Directory.Build.props. -->
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net10.0;netstandard2.0</TargetFrameworks>
    <AssemblyName>Clast.Drivers.SqlServer</AssemblyName>
    <RootNamespace>Clast.Drivers.SqlServer</RootNamespace>
    <IsAotCompatible Condition="'$(TargetFramework)' != 'netstandard2.0'">true</IsAotCompatible>
    <Description>ADBC driver for Microsoft SQL Server and other TDS-compatible databases.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Clast.Drivers.SqlServer.Tests" Key="$(ClastPublicKey)" />
    <InternalsVisibleTo Include="Clast.Drivers.SqlServer.Benchmarks" Key="$(ClastPublicKey)" />
    <InternalsVisibleTo Include="Clast.Drivers.SqlServer.Native.Tests" Key="$(ClastPublicKey)" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Substrait\Dialect\sqlserver_dialect.yaml" LogicalName="Clast.Drivers.SqlServer.sqlserver_dialect.yaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Apache.Arrow" />
    <ProjectReference Include="$(AdbcProject)" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Microsoft.Win32.Registry" />
    <PackageReference Include="System.Text.Encoding.CodePages" />
    <PackageReference Include="System.Threading.Channels" />
  </ItemGroup>

</Project>
