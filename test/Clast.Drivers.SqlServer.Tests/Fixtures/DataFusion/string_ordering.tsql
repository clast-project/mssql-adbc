SELECT [t0].[name] AS [name]
FROM [orders] AS [t0]
WHERE ([t0].[name] COLLATE Latin1_General_100_BIN2_UTF8 > N'Apple' COLLATE Latin1_General_100_BIN2_UTF8)
ORDER BY CASE WHEN [t0].[name] COLLATE Latin1_General_100_BIN2_UTF8 IS NULL THEN 1 ELSE 0 END, [t0].[name] COLLATE Latin1_General_100_BIN2_UTF8
