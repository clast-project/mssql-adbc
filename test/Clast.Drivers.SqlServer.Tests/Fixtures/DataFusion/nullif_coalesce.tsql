SELECT NULLIF([t0].[name] COLLATE Latin1_General_100_BIN2_UTF8, N'a' COLLATE Latin1_General_100_BIN2_UTF8) AS [n], CASE WHEN ([t0].[name] COLLATE Latin1_General_100_BIN2_UTF8 IS NOT NULL) THEN [t0].[name] COLLATE Latin1_General_100_BIN2_UTF8 ELSE N'none' COLLATE Latin1_General_100_BIN2_UTF8 END AS [c]
FROM [orders] AS [t0]
