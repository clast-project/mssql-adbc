SELECT COUNT_BIG(CAST(1 AS bigint)) AS [customer_id], CAST(CASE GROUPING_ID([t0].[customer_id], [t0].[flag]) WHEN 3 THEN 0 WHEN 1 THEN 1 WHEN 2 THEN 2 WHEN 0 THEN 3 END AS int) AS [flag], CASE WHEN CAST(CASE GROUPING_ID([t0].[customer_id], [t0].[flag]) WHEN 3 THEN 0 WHEN 1 THEN 1 WHEN 2 THEN 2 WHEN 0 THEN 3 END AS int) IN (1) THEN [t0].[customer_id] END AS [n]
FROM [orders] AS [t0]
GROUP BY GROUPING SETS ((), ([t0].[customer_id]), ([t0].[flag]), ([t0].[customer_id], [t0].[flag]))
