SELECT [t0].[id] AS [id], CASE WHEN ([t1].[cname] COLLATE Latin1_General_100_BIN2_UTF8 IS NOT NULL) THEN [t1].[cname] COLLATE Latin1_General_100_BIN2_UTF8 ELSE N'none' COLLATE Latin1_General_100_BIN2_UTF8 END AS [cname]
FROM [orders] AS [t0]
LEFT JOIN [customers] AS [t1] ON ([t0].[customer_id] = [t1].[id])
