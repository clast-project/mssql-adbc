SELECT [t0].[customer_id] AS [customer_id], (CAST([t0].[qty] AS bigint) % CAST(2 AS bigint)) AS [parity], CAST(CASE GROUPING_ID([t0].[customer_id], (CAST([t0].[qty] AS bigint) % CAST(2 AS bigint))) WHEN 1 THEN 0 WHEN 2 THEN 1 WHEN 3 THEN 2 END AS int) AS [n]
FROM [orders] AS [t0]
GROUP BY GROUPING SETS (([t0].[customer_id]), ((CAST([t0].[qty] AS bigint) % CAST(2 AS bigint))), ())
